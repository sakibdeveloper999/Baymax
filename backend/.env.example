# Server
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Copy the connection string from Neon > Connect. Keep it private.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# Generate three separate random secrets before running.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
QR_SECRET=replace-with-another-random-secret-at-least-32-characters

RECEIPT_BASE_URL=http://localhost:3000/receipt
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8000
SOCKET_URL=http://localhost:5000
PRINTER_INTERFACE=192.168.1.100:9100
PRINTER_WIDTH=58mm
OFFLINE_DB_PATH=./data/pos.db
TIMEZONE=UTC
